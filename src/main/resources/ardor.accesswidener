accessWidener v2 official

# ClientInput.moveVector is protected -- it's the field that actually drives
# LocalPlayer movement (via applyInput() -> xxa/zza), not keyPresses. Widened
# so PathExecutor can set it directly while driving the bot programmatically.
# See PathExecutor.java's Javadoc for the full story (confirmed via javap
# disassembly of LocalPlayer.applyInput()/aiStep(), KeyboardInput.tick()).
accessible field net/minecraft/client/player/ClientInput moveVector Lnet/minecraft/world/phys/Vec2;

# pickBlockOrEntity is private -- PickWheelKey calls it directly on a tap (PickBlockMixin
# unconditionally swallows vanilla's own automatic call inside handleKeybinds(), so PickWheelKey
# is the sole place that ever performs pick-block now; see its class doc).
accessible method net/minecraft/client/Minecraft pickBlockOrEntity ()V

# closeContainer is protected -- RealCraftingController needs to properly close a real crafting
# table's menu after taking a crafted result from it (sends the real close packet + resets
# player.containerMenu to the default inventory menu), the same thing a Screen's own onClose does
# when a player backs out of a container GUI normally.
accessible method net/minecraft/world/entity/player/Player closeContainer ()V

# Gui's action-bar and title/subtitle state is private with public SETTERS only (setOverlayMessage,
# setTitle, setSubtitle) and no getters at all -- HudManager needs to READ what's currently showing
# (for the Lua HudManager.actionBar()/.title() queries), which is pure visibility, not new behavior,
# so it's widened here rather than given a Mixin @Accessor interface. The *Time fields are the
# countdowns: <= 0 means nothing is on screen right now, so the text field alone isn't enough.
accessible field net/minecraft/client/gui/Gui overlayMessageString Lnet/minecraft/network/chat/Component;
accessible field net/minecraft/client/gui/Gui overlayMessageTime I
accessible field net/minecraft/client/gui/Gui title Lnet/minecraft/network/chat/Component;
accessible field net/minecraft/client/gui/Gui subtitle Lnet/minecraft/network/chat/Component;
accessible field net/minecraft/client/gui/Gui titleTime I

# BossHealthOverlay.events (UUID -> LerpingBossEvent) is the live set of boss bars; the class itself
# and its getter (Gui.getBossOverlay()) are already public, as is everything HudManager reads off
# each event (BossEvent.getName/getProgress/getColor) -- only the map is private.
accessible field net/minecraft/client/gui/components/BossHealthOverlay events Ljava/util/Map;
